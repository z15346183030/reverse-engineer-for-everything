{
  "browser": {
    "mode": "launch",
    "executable_path": "/usr/bin/chromium",
    "headless": true
  },
  "start_url": {
    "url": "https://lightchainai.com/",
    "query": []
  },
  "environment": {
    "viewport": { "width": 1440, "height": 900, "device_scale_factor": 1 },
    "locale": "en-US",
    "timezone": "UTC",
    "color_scheme": "light",
    "reduced_motion": "reduce",
    "service_workers": "block"
  },
  "actions": [
    {
      "step_id": "load-home",
      "action": "goto",
      "destination": { "url": "https://lightchainai.com/", "query": [] },
      "wait_until": "load",
      "timeout_ms": 30000
    },
    {
      "step_id": "observe-hydration",
      "action": "wait_for_timeout",
      "duration_ms": 4000
    }
  ],
  "secrets": [],
  "capture": {
    "after_each_step": [],
    "at_end": ["url", "dom"],
    "events": ["network", "console", "page-errors", "frames", "workers"],
    "network": {
      "request_body": false,
      "response_body": false,
      "header_values": false
    }
  }
}
